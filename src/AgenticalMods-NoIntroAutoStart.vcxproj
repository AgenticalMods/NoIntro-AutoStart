<?xml version="1.0" encoding="utf-8"?>
<!--
  AgenticalMods-NoIntroAutoStart plugin (advance past PRESS (SPACE) TO START to the menu).
  Client build only. Requires the AlienX StarRupture Plugin SDK — see BUILD.md.
  SdkDir defaults to a sibling clone of the SDK next to this repo; override with
  /p:SdkDir=<path> if it lives elsewhere. PlatformToolset v145 — retarget to the
  toolset you have installed (the SDK templates ship v143).
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Client Debug|x64">
      <Configuration>Client Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Client Release|x64">
      <Configuration>Client Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <Keyword>Win32Proj</Keyword>
    <ProjectGuid>{7A1E9C2B-6D48-4B3F-9E21-0A5C7D8E1F30}</ProjectGuid>
    <RootNamespace>NoIntroAutoStart</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <!-- AlienX Plugin SDK root. Default = a sibling clone next to this repo; override with /p:SdkDir=<path>. -->
    <SdkDir Condition="'$(SdkDir)'==''">$(ProjectDir)..\..\StarRupture-Plugin-SDK\</SdkDir>
    <SdkClientDir>$(SdkDir)StarRupture SDK\Client\SDK\</SdkClientDir>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Condition="'$(Configuration)'=='Client Debug'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Client Release'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>

  <PropertyGroup>
    <OutDir>$(ProjectDir)bin\$(Configuration)\</OutDir>
    <IntDir>$(ProjectDir)obj\$(Configuration)\</IntDir>
    <TargetName>AgenticalMods-NoIntroAutoStart</TargetName>
    <TargetExt>.dll</TargetExt>
  </PropertyGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)'=='Client Debug'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <PreprocessorDefinitions>_DEBUG;MODLOADER_CLIENT_BUILD;NOINTRO_EXPORTS;MODLOADER_BUILD_TAG="1.1.0";_WINDOWS;_USRDLL;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <AdditionalIncludeDirectories>$(SdkDir)StarRupture SDK\Client\;$(SdkClientDir);$(SdkDir)include;$(ProjectDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <!-- Embed only the PDB file name, not the absolute build path. -->
      <AdditionalOptions>/PDBALTPATH:%_PDB% %(AdditionalOptions)</AdditionalOptions>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <EnableUAC>false</EnableUAC>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Client Release'">
    <ClCompile>
      <WarningLevel>TurnOffAllWarnings</WarningLevel>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <SDLCheck>true</SDLCheck>
      <PreprocessorDefinitions>NDEBUG;MODLOADER_CLIENT_BUILD;NOINTRO_EXPORTS;MODLOADER_BUILD_TAG="1.1.0";_WINDOWS;_USRDLL;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <AdditionalIncludeDirectories>$(SdkDir)StarRupture SDK\Client\;$(SdkClientDir);$(SdkDir)include;$(ProjectDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <!-- Embed only the PDB file name, not the absolute build path. -->
      <AdditionalOptions>/PDBALTPATH:%_PDB% %(AdditionalOptions)</AdditionalOptions>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <EnableUAC>false</EnableUAC>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClInclude Include="$(SdkDir)include\plugin_interface.h" />
    <ClInclude Include="plugin.h" />
    <ClInclude Include="plugin_config.h" />
    <ClInclude Include="plugin_helpers.h" />
  </ItemGroup>
  <ItemGroup>
    <!-- SDK support sources (compiled from the SDK tree; outputs land in our obj/) -->
    <ClCompile Include="$(SdkClientDir)Basic.cpp">
      <Visible>false</Visible>
    </ClCompile>
    <ClCompile Include="$(SdkClientDir)CoreUObject_functions.cpp">
      <Visible>false</Visible>
    </ClCompile>
    <ClCompile Include="$(SdkClientDir)Engine_functions.cpp">
      <Visible>false</Visible>
    </ClCompile>
    <!-- Plugin sources -->
    <ClCompile Include="dllmain.cpp" />
    <ClCompile Include="plugin.cpp" />
    <ClCompile Include="plugin_config.cpp" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
